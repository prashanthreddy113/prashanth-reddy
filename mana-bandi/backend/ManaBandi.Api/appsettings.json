{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Update": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": { "IncludeScopes": false, "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ", "UseUtcTimestamp": true }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Key": ""
  },
  "Otp": {
    "DevMode": false,
    "Provider": "console",
    "ExpirySeconds": 300,
    "MaxAttempts": 5,
    "MaxPerWindow": 3,
    "WindowMinutes": 10
  },
  "Msg91": {
    "AuthKey": "",
    "TemplateId": "",
    "BaseUrl": "https://control.msg91.com",
    "FlowTemplates": {
      "sos_trusted_contact": "",
      "captain_reupload": ""
    }
  },
  "Dispatch": {
    "Enabled": true,
    "OfferSeconds": 15,
    "RadiiKm": "3,5,8",
    "MaxSearchSeconds": 90,
    "TickMs": 1000,
    "HeartbeatStaleSeconds": 60
  },
  "Files": {
    "Root": "data/files",
    "MaxBytes": 8388608
  },
  "Public": {
    "BaseUrl": "https://api.manabandi.in",
    "TrackExpiryHours": 2
  },
  "Cors": {
    "AllowedOrigins": ""
  },
  "Proxy": {
    "TrustForwardedHeaders": true
  },
  "RateLimit": {
    "OtpPerMinute": 20,
    "LoginPerMinute": 10
  },
  "Seed": {
    "OwnerEmail": "owner@manabandi.in",
    "OwnerPassword": "",
    "DemoData": false
  },
  "Swagger": {
    "Enabled": false
  }
}
