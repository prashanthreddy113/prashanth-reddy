<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG builds only (this file overrides src/main/res/xml/network_security_config.xml).

     Plain http is allowed so a tester can run the backend on a laptop:
       - 10.0.2.2  = the host machine seen from the Android emulator
       - localhost / 127.0.0.1 (adb reverse tcp:5080 tcp:5080)
       - a laptop on the same Wi-Fi (192.168.x.x, 10.x.x.x, 172.16-31.x.x)

     Network security config cannot express IP ranges, so the base config permits cleartext in
     debug and ApiClient.isCleartextAllowed() refuses any http:// base URL whose host is not one of
     the addresses above. OpenStreetMap tiles are https. Release builds stay HTTPS only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
