# HTTPS for the API. Caddy gets a Let's Encrypt certificate for {$API_DOMAIN} on first start
# (the domain's DNS A record must already point at this server, ports 80 and 443 open).
{$API_DOMAIN} {
	encode gzip
	request_body {
		max_size 10MB
	}
	reverse_proxy api:8080 {
		header_up X-Forwarded-Proto {scheme}
	}
	log {
		output stdout
		format console
	}
}
