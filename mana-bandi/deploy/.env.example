# ---- copy to .env on the server and fill in; never commit .env ----
API_DOMAIN=api.manabandi.in

# (Use a database password without ";" characters.)
# Managed PostgreSQL (DigitalOcean → Databases → Connection details → "Connection parameters"):
DATABASE_URL=Host=db-xxxx.b.db.ondigitalocean.com;Port=25060;Database=manabandi;Username=doadmin;Password=CHANGE_ME;SSL Mode=Require;Trust Server Certificate=true
# Using --profile localdb instead? Then:
# DATABASE_URL=Host=db;Port=5432;Database=manabandi;Username=manabandi;Password=same-as-LOCAL_DB_PASSWORD
# LOCAL_DB_PASSWORD=choose-a-long-password

# 48+ random characters:  openssl rand -base64 48
Jwt__Key=CHANGE_ME

# Owner login for the portal (created on first start only)
Seed__OwnerEmail=owner@manabandi.in
Seed__OwnerPassword=CHANGE_ME_long_password

# OTP: keep DevMode=false for real users. Provider msg91 after DLT approval.
Otp__DevMode=false
Otp__Provider=msg91
Msg91__AuthKey=CHANGE_ME
Msg91__TemplateId=CHANGE_ME

# The owner portal's address
Cors__AllowedOrigins=https://admin.manabandi.in

# Leave false in production (demo captains are for testing only)
Seed__DemoData=false
