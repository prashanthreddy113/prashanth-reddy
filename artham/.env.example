# ---------- AI (required to go live) ----------
# Claude API key from https://console.anthropic.com  (Settings -> API keys)
ANTHROPIC_API_KEY=
# Model used to read documents. Default: claude-opus-5-5 (best quality, ~Rs 4 per 2-page document).
# Cheaper options: claude-sonnet-5-5 (~Rs 2) or claude-haiku-5-5 (~Rs 0.10).
ARTHAM_MODEL=claude-opus-5-5
# low | medium | high. Higher = more careful reading, slower and costlier.
ARTHAM_EFFORT=medium

# ---------- Payments: Razorpay ----------
# Dashboard -> Account & Settings -> API Keys. Use rzp_test_... keys first, then rzp_live_... after KYC.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks -> add https://YOUR-SITE/api/payments/webhook with events payment.captured + order.paid
RAZORPAY_WEBHOOK_SECRET=

# ---------- Business details (shown on Terms / Privacy / Refund / Contact pages; Razorpay KYC checks these) ----------
NEXT_PUBLIC_SITE_NAME=Artham
NEXT_PUBLIC_BUSINESS_NAME=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=

# ---------- Storage ----------
# "blobs" on Netlify (Netlify Blobs), "file" for local development (.data/store.json).
STORE_BACKEND=file

# ---------- Security / limits ----------
# Long random string. Used to hash IP addresses (never stored in plain form).
HASH_SALT=change-me-to-a-long-random-string
# Secret for the /admin stats page.
ADMIN_KEY=
# Free documents for every new visitor, and how many new free wallets one IP address can get per day.
FREE_CREDITS=2
FREE_WALLETS_PER_IP_PER_DAY=10

# Local testing only: show a sample explanation when no ANTHROPIC_API_KEY is set (ignored in production
# unless set to "true"), and allow "test payments" when Razorpay keys are missing (never in production).
DEMO_MODE=
